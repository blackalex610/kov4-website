# ─── Brand ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=kov4
NEXT_PUBLIC_SITE_URL=https://kov4.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@kov4.com

# ─── Sample social proof ────────────────────────────────────────────────────
# Shows FICTIONAL client logos, case studies and a quote (src/content/sample-proof.ts).
# For local previews only. Keep this unset or "false" in production.
NEXT_PUBLIC_SHOW_SAMPLE_PROOF=false

# ─── Contact form delivery ──────────────────────────────────────────────────
# One of: webhook | resend | file
# Unset = the form refuses submissions with a clear message and offers an email fallback.
LEAD_PROVIDER=

# webhook: POSTs JSON to any URL (Make, Zapier, n8n, Slack workflow, CRM).
LEAD_WEBHOOK_URL=
# Optional. Adds header  x-signature-256: sha256=<HMAC of the raw body>
LEAD_WEBHOOK_SECRET=

# resend: sends an email per submission via https://resend.com
RESEND_API_KEY=
LEAD_EMAIL_TO=hello@kov4.com
LEAD_EMAIL_FROM=kov4 website <forms@kov4.com>

# file: appends to .leads/leads.jsonl. Local development only.
